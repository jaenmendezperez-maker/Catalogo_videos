meta {
  name: Cambiar contrasena
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/cambiar-password
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "contrasenaActual": "{{passwordAdmin}}",
    "contrasenaNueva": "{{passwordAdmin}}",
    "confirmarContrasena": "{{passwordAdmin}}"
  }
}

tests {
  test("responde 204", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  Va en la carpeta final a proposito: cambiar la contrasena revoca TODOS los
  refresh tokens del usuario, asi que romperia cualquier peticion posterior.

  La contrasena nueva es la misma que la actual para que la coleccion se pueda
  reejecutar. Cambia el valor si quieres probar un cambio real, pero recuerda
  actualizar passwordAdmin en el entorno despues.
}
