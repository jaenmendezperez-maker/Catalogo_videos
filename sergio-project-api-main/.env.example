# Copia este archivo a .env y rellena los valores.  cp .env.example .env
# .env está en .gitignore: nunca se versiona.

# ── PostgreSQL del contenedor ────────────────────────────
POSTGRES_DB=DBsergioAPI
POSTGRES_USER=sergio
POSTGRES_PASSWORD=cambia-esta-contrasena
# 5434: el 5432 lo ocupa tu PostgreSQL local y el 5433 ya estaba tomado
POSTGRES_PUERTO_HOST=5434
# Conexiones maximas del pool de la API. Debe quedar por debajo del max_connections
# de Postgres (100 por defecto) para dejar sitio a psql y a las migraciones.
DB_MAX_POOL=40

# ── API ──────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
API_PUERTO_HOST=8081

# ── JWT ──────────────────────────────────────────────────
# Genera una con:  openssl rand -base64 48
JWT_SECRET_KEY=
JWT_ISSUER=SergioApi
JWT_AUDIENCE=SergioApiClientes
JWT_ACCESS_MINUTOS=60
JWT_REFRESH_DIAS=7

# ── Google OAuth (opcional) ──────────────────────────────
GOOGLE_CLIENT_ID=

# ── Bunny Stream ─────────────────────────────────────────
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=
BUNNY_API_BASE_URL=https://video.bunnycdn.com
# OBLIGATORIA fuera de Development. Sin ella la API se niega a devolver
# URLs de reproducción, porque servirlas sin firmar es el bypass del paywall.
BUNNY_TOKEN_AUTH_KEY=

# ── Mercado Pago (suscripciones) ─────────────────────────
# Obligatorio fuera de Development: sin esto la API no arranca.
# Access Token del VENDEDOR. Fuera de Development se rechaza uno de prueba (TEST-):
# para probar con el sandbox, arranca con ASPNETCORE_ENVIRONMENT=Development.
MP_ACCESS_TOKEN=
# Clave secreta de webhooks: panel de Mercado Pago > Tus integraciones > Webhooks.
MP_WEBHOOK_SECRET=
# Cambiarlo no afecta a quien ya esta suscrito: cada suscripcion guarda su monto.
MP_PRECIO_MENSUAL=99
# A donde vuelve el usuario tras pagar. Debe ser https: Mercado Pago rechaza localhost.
MP_BACK_URL=

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGEN_1=http://localhost:5173
CORS_ORIGEN_2=http://localhost:3000

# ── Red / proxies ────────────────────────────────────────
# Deja esto VACIO si la API recibe el trafico directamente.
# Si pones nginx, Traefik o Cloudflare delante, declara aqui su IP o su red en
# notacion CIDR; solo entonces se hara caso a la cabecera X-Forwarded-For.
# Rellenarlo a la ligera permite que cualquiera suplante su IP y se salte el
# rate limiting mandando una distinta en cada peticion.
# Ejemplo: RED_PROXY_1=10.0.0.5    RED_CIDR_1=172.16.0.0/12
RED_PROXY_1=
RED_CIDR_1=
